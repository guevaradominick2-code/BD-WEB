# Public Supabase project values. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: enable the clearly labelled local demo when Supabase is unavailable.
# This flag is ignored in production.
NEXT_PUBLIC_DEMO_MODE=true

# Used to create absolute URLs in metadata and auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IANA timezone used by reveal rules and date labels.
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Costa_Rica
