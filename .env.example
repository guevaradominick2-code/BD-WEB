# Public Supabase project values. The publishable key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: enable the clearly labelled local demo when Supabase is unavailable.
# This flag is ignored in production.
NEXT_PUBLIC_DEMO_MODE=true

# Used to create absolute URLs in metadata and auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IANA timezone used by reveal rules and date labels.
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Costa_Rica

# Private guest entrance. Keep both values secret and configure them in Vercel.
ACCESS_WORD=
ACCESS_SESSION_SECRET=

# Server-only key used after the signed private-word cookie is verified.
# Never prefix this variable with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
